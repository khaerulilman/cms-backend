# Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git

# Database Connection
# PostgreSQL connection string format:
# postgresql://username:password@host:port/database
DATABASE_URL=postgresql://neondb_owner:your_password@your_host:5432/your_database

# JWT Configuration
# Generate a strong secret key (minimum 32 characters recommended)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-min-32-characters-recommended

# Frontend URL
# URL of your frontend application for CORS
FRONTEND_URL=http://localhost:3000

# Node Environment
# Values: development, production, test
NODE_ENV=development

# Server Port
# Default: 3001
PORT=3001

# Optional: Database Pool Size (for production)
# DATABASE_POOL_SIZE=20

# Optional: Log Level
# Values: debug, info, warn, error
# LOG_LEVEL=info

# Optional: Enable API Documentation
# API_DOCS_ENABLED=true
