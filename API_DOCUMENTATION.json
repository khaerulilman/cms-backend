{
  "info": {
    "name": "Portfolio CMS Backend API",
    "version": "1.0.0",
    "description": "API untuk Portfolio CMS Backend dengan dukungan API Key"
  },
  "baseUrl": "http://localhost:4000",
  "endpoints": [
    {
      "name": "Auth - Register",
      "method": "POST",
      "url": "/api/v1/auth/register",
      "body": {
        "email": "user@example.com",
        "password": "SecurePassword123!",
        "name": "John Doe"
      },
      "response": {
        "success": true,
        "message": "User registered successfully",
        "data": {
          "user": {
            "id": "uuid",
            "email": "user@example.com",
            "name": "John Doe",
            "createdAt": "timestamp"
          },
          "accessToken": "jwt_token",
          "refreshToken": "jwt_token"
        }
      }
    },
    {
      "name": "Auth - Login",
      "method": "POST",
      "url": "/api/v1/auth/login",
      "body": {
        "email": "user@example.com",
        "password": "SecurePassword123!"
      },
      "response": {
        "success": true,
        "message": "Login successful",
        "data": {
          "user": {
            "id": "uuid",
            "email": "user@example.com",
            "name": "John Doe",
            "createdAt": "timestamp"
          },
          "accessToken": "jwt_token",
          "refreshToken": "jwt_token"
        }
      }
    },
    {
      "name": "Auth - Generate API Key",
      "method": "POST",
      "url": "/api/v1/auth/generate-api-key",
      "headers": {
        "Authorization": "Bearer {accessToken}"
      },
      "body": "{}",
      "description": "Generate new API Key untuk user yang sudah login",
      "response": {
        "success": true,
        "message": "API key generated successfully",
        "data": {
          "apiKey": "sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
        }
      }
    },
    {
      "name": "Auth - Regenerate API Key",
      "method": "POST",
      "url": "/api/v1/auth/regenerate-api-key",
      "headers": {
        "Authorization": "Bearer {accessToken}"
      },
      "body": "{}",
      "description": "Regenerate API Key (mengganti key yang lama)",
      "response": {
        "success": true,
        "message": "API key regenerated successfully",
        "data": {
          "apiKey": "sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
        }
      }
    },
    {
      "name": "Table - Get Table by ID with API Key",
      "method": "GET",
      "url": "/api/v1/project/:projectId/table/:tableId",
      "headers": {
        "x-api-key": "sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
      },
      "params": {
        "projectId": "uuid",
        "tableId": "uuid"
      },
      "description": "Get table lengkap dengan columns, rows, dan cells menggunakan API Key",
      "response": {
        "success": true,
        "message": "Table retrieved successfully",
        "data": {
          "id": "uuid",
          "projectId": "uuid",
          "name": "Table Name",
          "columns": [
            {
              "id": "uuid",
              "name": "Column Name",
              "createdAt": "timestamp",
              "updatedAt": "timestamp"
            }
          ],
          "rows": [
            {
              "id": "uuid",
              "createdAt": "timestamp",
              "updatedAt": "timestamp",
              "cells": [
                {
                  "id": "uuid",
                  "columnId": "uuid",
                  "value": "cell value",
                  "createdAt": "timestamp",
                  "updatedAt": "timestamp"
                }
              ]
            }
          ],
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      }
    }
  ]
}
